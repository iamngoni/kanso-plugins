  "permissions": {
    "commands": true,
    "editor": [
      "note.read"
    ],
    "notes": {
      "read": {
        "books": [],
        "tags": [],
        "all": false
      },
      "write": [
        "notebooks you choose"
      ]
    },
    "ui": [
      "panel"
    ],
    "secrets": [
      "devto-key",
      "wordpress-token",
      "hashnode-token"
    ],
    "network": [
      "dev.to",
      "gql.hashnode.com",
      "public-api.wordpress.com"
    ]
  }
}
